{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensor_event.schema.json",
  "title": "SensorEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "asset_id",
    "timestamp_utc",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "additionalProperties": false
}
